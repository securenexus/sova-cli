cabal-version: 2.4
name:           myproject
version:        1.0.0
license:        MIT
author:         Test Author

library
  exposed-modules:     MyProject.Lib
  build-depends:
      base >=4.7 && <5
    , aeson >=2.1 && <3
    , text >=2.0 && <3
    , bytestring >=0.11 && <1
  default-language: Haskell2010

executable myproject
  main-is:             Main.hs
  build-depends:
      base >=4.7 && <5
    , myproject
    , optparse-applicative >=0.17 && <1
  default-language: Haskell2010
