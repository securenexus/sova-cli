{
  "name": "@securenexus/sova",
  "version": "1.1.0",
  "description": "SOVA - Supply Chain Orchestration & Visualization Assistant. Extract dependency information from any project for SBOM generation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "sova": "bin/sova.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sbom",
    "dependency",
    "security",
    "supply-chain",
    "sca",
    "vulnerability",
    "securenexus",
    "sova",
    "cyclonedx",
    "spdx"
  ],
  "author": "SecureNexus <info@securenexus.ai>",
  "license": "Apache-2.0",
  "homepage": "https://www.securenexus.ai/",
  "repository": {
    "type": "git",
    "url": "https://github.com/securenexus/sova-cli"
  },
  "bugs": {
    "url": "https://github.com/securenexus/sova-cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.4.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
